# 统一换行符为 LF, 防止 Windows 下 README 乱码/差异
* text=auto

# 文档文件强制 LF
*.md text eol=lf
*.txt text eol=lf

# Java / 前端源码
*.java text eol=lf
*.js text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.sql text eol=lf

# 二进制文件不做文本转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.jar binary
*.docx binary
*.xlsx binary
