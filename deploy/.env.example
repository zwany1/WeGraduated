# ============ 生产环境密钥配置 ============
# 复制为 .env 后填写真实值, 切勿提交仓库
# cp deploy/.env.example deploy/.env

# MySQL root 密码(必填, 自行设置强密码)
MYSQL_ROOT_PASSWORD=change-me-strong-password

# 邮箱 SMTP 授权码(必填, 用于发送邮箱验证码)
MAIL_PASSWORD=your-smtp-auth-code

# JWT 签名密钥(必填, 至少32位随机字符串, 可用: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-at-least-32-chars

# 默认管理员账号(可选)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me

# 前端访问地址(必填, 影响CORS与GitHub OAuth回调, 按实际域名/IP填写, 例如: http://123.56.158.11)
# CORS_ORIGINS=http://123.56.158.11

# GitHub OAuth(可选, 未申请可留空): 在 GitHub OAuth App 中把 Authorization callback URL 填为
#   http://123.56.158.11/api/auth/github/callback 后, 填入下面两个值启用 GitHub 登录
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
