# 论文排版系统 nginx 参考配置(前端 SPA + 后端 API 反代)
# 部署: 前端 npm run build 产物(dist)放 /var/www/thesis-format; 后端 13355

server {
    listen 80;
    server_name your-domain.com;
    root /var/www/thesis-format;
    index index.html;

    # gzip 压缩(排版 diff 文本较大, 压缩省带宽)
    gzip on;
    gzip_types text/plain application/json application/javascript text/css;
    gzip_min_length 1024;

    # 前端 SPA(history 模式): 刷新非根路径需 fallback 到 index.html, 否则 404
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 后端 API 反代(前端 baseURL=/api, 由 nginx 转发到后端 13355)
    location /api/ {
        proxy_pass http://127.0.0.1:13355/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE 排版进度/长任务: 关闭缓冲, 延长超时
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        # 文件上传上限与后端 multipart 一致
        client_max_body_size 60m;
    }

    # 静态资源长缓存(vite 构建产物带 hash)
    location ~* \.(js|css|woff2?|png|jpg|svg)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
